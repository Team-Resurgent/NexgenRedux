# Fails if the engine starts to depend on anything outside this folder besides the compiler, the
# C and C++ standard libraries and the platform's own SDK. Run as a test:
#
#   cmake -DROOT=<engine folder> -P CheckSelfContained.cmake

cmake_minimum_required(VERSION 3.21)
set(_problems "")

# Small source libraries, each a copy kept here. No frameworks such as SDL or GLFW.
set(_allowed angelscript ssfn stb miniaudio dr_libs miniz cgltf mbedtls)
file(GLOB _third_party RELATIVE "${ROOT}/third_party" "${ROOT}/third_party/*")
foreach(_library IN LISTS _third_party)
  if(NOT _library IN_LIST _allowed)
    list(APPEND _problems "third_party/${_library} is not on the list of allowed libraries")
  endif()
endforeach()

# Nothing may be downloaded or searched for at build time.
file(GLOB_RECURSE _cmake_files "${ROOT}/CMakeLists.txt" "${ROOT}/cmake/*.cmake")
foreach(_file IN LISTS _cmake_files)
  if(_file MATCHES "/(build|third_party)/" OR _file MATCHES "CheckSelfContained.cmake$")
    continue()
  endif()
  file(STRINGS "${_file}" _hits REGEX "FetchContent|ExternalProject|find_package|find_library|file\\(DOWNLOAD")
  if(_hits)
    list(APPEND _problems "${_file} brings in something from outside: ${_hits}")
  endif()
endforeach()

# Headers: the standard libraries, platform SDKs and AngelScript. Quoted includes must be ours.
set(_standard "pthread|time|errno|assert|atomic|algorithm|bit|float|limits|math|new|stdarg|stddef|stdint|stdio|stdlib|string|type_traits|utility|vector|wchar")
set(_platform "windows|d3d11|d3dcompiler|dxgi1_3|xinput|xtl|xboxkrnl/xboxkrnl|xgraphics|dirent|fcntl|linux/input|sys/ioctl|sys/stat|unistd|dlfcn|winsock2|ws2tcpip|winsockx|bcrypt|arpa/inet|ifaddrs|net/if|netdb|netinet/in|netinet/tcp|sys/select|sys/socket|sys/time|mach-o/dyld|X11/Xlib|X11/Xutil|X11/keysym|GL/glx|Cocoa/Cocoa|GameController/GameController")
file(GLOB_RECURSE _sources "${ROOT}/*.cpp" "${ROOT}/*.h" "${ROOT}/*.mm")
foreach(_file IN LISTS _sources)
  if(_file MATCHES "/(build|third_party)/")
    continue()
  endif()
  file(RELATIVE_PATH _name "${ROOT}" "${_file}")
  file(STRINGS "${_file}" _includes REGEX "^[ \t]*#[ \t]*(include|import)")
  foreach(_include IN LISTS _includes)
    if(_include MATCHES "<([^>]+)>")
      set(_header "${CMAKE_MATCH_1}")
      if(_header MATCHES "^(${_standard})(\\.h)?$")
        continue()
      elseif(_header MATCHES "^(${_platform})\\.h$" AND _name MATCHES "^(platform/|gpu/|base/thread_|audio/output_|net/|tests/test_net)")
        continue()
      elseif(_header MATCHES "^(mbedtls|psa)/" AND _name MATCHES "^net/")
        continue()
      elseif(_header MATCHES "^winrt/Windows[.]" AND _name MATCHES "^platform/uwp/")
        continue()
      elseif(_name MATCHES "^tools/" AND _header MATCHES "^(filesystem|fstream|set|system_error|vector)$")
        continue()
      elseif(_header STREQUAL "scriptarray/scriptarray.h" AND _name MATCHES "^bindings/")
        continue()
      elseif(_header STREQUAL "angelscript.h" AND _name MATCHES "^(script|bindings|scene|screens|spike|app)/")
        continue()
      endif()
      list(APPEND _problems "${_name} includes <${_header}>")
    elseif(_include MATCHES "\"([^\"]+)\"")
      set(_header "${CMAKE_MATCH_1}")
      get_filename_component(_dir "${_file}" DIRECTORY)
      if(EXISTS "${ROOT}/${_header}" OR EXISTS "${_dir}/${_header}")
        continue()
      elseif(_name MATCHES "^script/" AND EXISTS "${ROOT}/third_party/angelscript/sdk/add_on/${_header}")
        continue()
      endif()
      list(APPEND _problems "${_name} includes \"${_header}\", which is not in the engine")
    endif()
  endforeach()
endforeach()

if(_problems)
  list(JOIN _problems "\n  " _text)
  message(FATAL_ERROR "The engine is no longer self-contained:\n  ${_text}")
endif()
message(STATUS "self-contained")
