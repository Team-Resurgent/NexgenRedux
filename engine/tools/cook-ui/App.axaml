<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NexgenCook.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#458CF5" RegionColor="#10141F" />
      </FluentTheme.Palettes>
    </FluentTheme>
  </Application.Styles>
</Application>
